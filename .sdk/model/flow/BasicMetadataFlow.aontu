# BasicMetadataFlow

main: kit: flow: BasicMetadataFlow:
{
  entity: "metadata",
  kind: "basic",
  name: "BasicMetadataFlow",
  step: [
    {
      i: {
        ref: "metadata_ref01"
      }

      m: {
        artifact_id: "artifact01",
        group_id: "group01",
        version_expression: "version_expression01"
      }

      o: "create"
    }

    {
      d: {
        group_id: "group01"
      }

      i: {
        ref: "metadata_ref01",
        srcdatavar: "metadata_ref01_data",
        suffix: "_up0",
        textfield: "artifactId"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-metadata_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "metadata_ref01",
        srcdatavar: "metadata_ref01_data",
        suffix: "_dt0"
      }

      m: {
        group_id: "group01",
        id: "metadata01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-metadata_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicMetadataFlow"
}