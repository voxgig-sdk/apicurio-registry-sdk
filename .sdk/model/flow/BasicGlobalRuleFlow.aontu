# BasicGlobalRuleFlow

main: kit: flow: BasicGlobalRuleFlow:
{
  entity: "global_rule",
  kind: "basic",
  name: "BasicGlobalRuleFlow",
  step: [
    {
      i: {
        ref: "global_rule_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "global_rule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "global_rule_ref01",
        suffix: "_rm0"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "global_rule_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicGlobalRuleFlow"
}