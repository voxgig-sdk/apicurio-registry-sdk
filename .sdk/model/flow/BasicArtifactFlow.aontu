# BasicArtifactFlow

main: kit: flow: BasicArtifactFlow:
{
  entity: "artifact",
  kind: "basic",
  name: "BasicArtifactFlow",
  step: [
    {
      i: {
        ref: "artifact_ref01"
      }

      m: {
        group_id: "group01"
      }

      o: "create"
    }

    {
      m: {
        group_id: "group01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "artifact_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "artifact_ref01",
        srcdatavar: "artifact_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "artifact01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-artifact_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "artifact_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "artifact01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        group_id: "group01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "artifact_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicArtifactFlow"
}