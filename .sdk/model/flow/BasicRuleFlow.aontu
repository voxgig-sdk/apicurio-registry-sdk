# BasicRuleFlow

main: kit: flow: BasicRuleFlow:
{
  entity: "rule",
  kind: "basic",
  name: "BasicRuleFlow",
  step: [
    {
      m: {
        group_id: "group01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "rule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "rule_ref01",
        srcdatavar: "rule_ref01_data",
        suffix: "_up0",
        textfield: "config"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-rule_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "rule_ref01",
        srcdatavar: "rule_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "rule01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-rule_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicRuleFlow"
}