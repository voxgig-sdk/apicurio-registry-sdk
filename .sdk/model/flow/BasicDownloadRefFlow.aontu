  name: "BasicDownloadRefFlow",
  step: [
    {
      i: {
        ref: "download_ref_ref01",
        srcdatavar: "download_ref_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
